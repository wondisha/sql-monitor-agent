# Copy to .env and fill in. Never commit .env.

# State store (default: local SQLite file). For production use Postgres:
# MONITOR_DB_URL=postgresql+psycopg://monitor_app:secret@localhost:5432/monitor_state
MONITOR_DB_URL=sqlite:///monitor_state.db

# Claude API key (or use `ant auth login`)
ANTHROPIC_API_KEY=

# Dashboard / API users: name:role:token, comma separated. role = viewer | approver
MONITOR_USERS=admin:approver:change-me-long-random-token
MONITOR_DASHBOARD_URL=http://localhost:8080

# ---- Lab targets (docker-compose in lab/) ----
PG_MONITOR_PASSWORD=monitor_pw
PG_EXECUTOR_PASSWORD=labpass
MYSQL_MONITOR_PASSWORD=monitor_pw
MYSQL_EXECUTOR_PASSWORD=labpass
MSSQL_MONITOR_PASSWORD=Monitor_pw1!
MSSQL_EXECUTOR_PASSWORD=Lab_pass1!

# ---- Snowflake (key-pair auth recommended) ----
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_MONITOR_USER=
SNOWFLAKE_MONITOR_KEY_PATH=
SNOWFLAKE_EXECUTOR_USER=
SNOWFLAKE_EXECUTOR_KEY_PATH=

# ---- Notifications ----
SLACK_WEBHOOK_URL=
TEAMS_WEBHOOK_URL=
PAGERDUTY_ROUTING_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
